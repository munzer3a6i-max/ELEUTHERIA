# Copy to .env.local and fill in from Supabase, Project Settings, API.
# The anon key is meant to be public: it ships inside the browser bundle.
# Its safety comes entirely from row level security being enabled on every
# table. The service_role key is the opposite and belongs in no frontend.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>
